# ==============================================================================
# Frontend (Vite / GitHub Pages) — Safe to expose in browser bundle
# ==============================================================================
# Backend Express API Base URL (leave empty in local single-origin dev; set to https://api.codenameamir.ir for GitHub Pages)
VITE_API_URL=""

# Optional base path for subpath hosting (default '/' works for History API routes; set '/subpath/' if deployed under a subfolder)
VITE_BASE_PATH="/"

# Optional legacy anon variables (not required when using Backend API; NEVER put Service Role key here)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ==============================================================================
# Backend API Server (Express on Render — NEVER expose to Vite/client bundle)
# ==============================================================================
# Allowed CORS origin(s) for cross-origin HttpOnly session cookies (comma-separated)
CORS_ORIGIN="https://amir-mobile-store.codenameamir.ir,https://admin-panel-ams.codenameamir.ir"

# Optional custom cookie domain (leave commented/empty for host-only cookies with SameSite=None; Secure)
# COOKIE_DOMAIN=""

# Supabase Server-Side Service Role (Required in production — KEEP SECRET ON RENDER ONLY)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Resend Email Configuration (Server-side only — https://resend.com/api-keys)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Amir Mobile <auth@codenameamir.ir>"

# Required strong HMAC secret (min 32 chars) for signing HttpOnly session cookies & OTP hashes
# Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=""

# Required strong secret (min 32 chars) for internal scheduled job endpoints (e.g. Render Cron calling POST /internal/jobs/expire-pending-orders)
# Generate with: openssl rand -hex 32
INTERNAL_JOB_SECRET=""
