# ==============================================================================
# Frontend (Vite / GitHub Pages) — Safe to expose in browser bundle
# ==============================================================================
# Supabase Free Plan Configuration
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Backend Express API Base URL (leave empty in local single-origin dev; set to https://api.codenameamir.ir for GitHub Pages)
VITE_API_URL=""

# Optional base path for GitHub Pages (default './' works for both subpath and custom CDN domains)
VITE_BASE_PATH="./"

# ==============================================================================
# Backend API Server (Express on Render — NEVER expose to Vite/client bundle)
# ==============================================================================
# Allowed CORS origin(s) for cross-origin HttpOnly session cookies (comma-separated if multiple)
CORS_ORIGIN="https://amir-mobile-store.codenameamir.ir"

# Optional custom cookie domain (leave empty for host-only api.codenameamir.ir with SameSite=None; Secure)
COOKIE_DOMAIN=""

# Supabase Server-Side Service Role (Required in production for persistent users & OTP challenges)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Resend Email Configuration (Server-side only — https://resend.com/api-keys)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Amir Mobile <auth@codenameamir.ir>"

# Required strong HMAC secret (min 32 chars) for signing HttpOnly session cookies & OTP hashes
# Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=""
